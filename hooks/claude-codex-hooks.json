{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "cat \"${CLAUDE_PLUGIN_ROOT}/AGENTS.md\" 2>/dev/null || exit 0",
            "commandWindows": "Get-Content \"$env:CLAUDE_PLUGIN_ROOT\\AGENTS.md\" -ErrorAction SilentlyContinue",
            "timeout": 5,
            "statusMessage": "Loading mkg's skill..."
          }
        ]
      }
    ]
  }
}
